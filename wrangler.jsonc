{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "univ-merch-store",
  "main": "src/server/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "univ_merch_db",
      "database_id": "local-univ-merch-db",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "MIDTRANS_IS_PRODUCTION": "false",
    "MIDTRANS_CLIENT_KEY": "SB-Mid-client-univ-sandbox-test",
    "MIDTRANS_SERVER_KEY": "SB-Mid-server-univ-sandbox-test"
  },
  "observability": {
    "enabled": true
  }
}
